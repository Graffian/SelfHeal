# Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the Groq model.
# Defaults to "openai/gpt-oss-120b" (Groq's current recommended model).
# Set to any model id from https://console.groq.com/docs/models
# e.g. openai/gpt-oss-20b (faster, more TPM headroom on the free tier)
GROQ_MODEL=openai/gpt-oss-120b

# Optional: HTTP request timeout for the real API call (milliseconds).
# REQUEST_TIMEOUT_MS=20000

# Optional: override the Groq API base URL (only needed for testing or a proxy).
# GROQ_BASE_URL=https://api.groq.com/openai/v1
