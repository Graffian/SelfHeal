# Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the Groq model.
# Default is "llama-3.3-70b-versatile".
#
# NOTE: Groq deprecated llama-3.3-70b-versatile (shutdown 2026-08-16).
# Recommended current replacements:
#   openai/gpt-oss-120b   (stronger, same price class)
#   openai/gpt-oss-20b    (faster, cheaper)
#   qwen/qwen3.6-27b
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: HTTP request timeout for the real API call (milliseconds).
# REQUEST_TIMEOUT_MS=20000

# Optional: override the Groq API base URL (only needed for testing or a proxy).
# GROQ_BASE_URL=https://api.groq.com/openai/v1
